{
  "name": "uteshop-backend",
  "version": "2.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "sequelize-cli db:migrate",
