# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uteshop
DB_USER=root
DB_PASSWORD=your_db_password_here

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (min 16 chars each - replace with random secure values)
JWT_ACCESS_SECRET=your_access_secret_min_16_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_16_chars_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# SMTP / Email
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@uteshop.com

# Seed credentials
SEED_ADMIN_EMAIL=admin@uteshop.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MANAGER_EMAIL=manager@uteshop.com
SEED_MANAGER_PASSWORD=Manager@1234
